	wan_delete "$idx"
	rc=$?
	json_init
	case $rc in
		0) json_add_boolean ok 1 ;;
		2) json_add_string error "no WAN connection $idx" ;;
		*) json_add_string error "the stock stack refused to delete WAN connection $idx" ;;
	esac
	json_dump
}


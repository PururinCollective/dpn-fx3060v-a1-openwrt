# --- boot banks / firmware ------------------------------------------------

m_boot_get() {
	local b
	json_init
	json_add_int running "$(running_bank)"
	json_add_string active "$(nv_get sw_active)"
	json_add_string commit "$(nv_get sw_commit)"
	json_add_string tryactive "$(nv_get sw_tryactive)"
	json_add_array banks
	for b in 0 1; do
		json_add_object
		json_add_int bank "$b"
		json_add_string version "$(nv_get sw_version$b)"
		json_add_string valid "$(nv_get sw_valid$b)"
		json_close_object
	done
	json_close_array
	json_dump
}

m_boot_set() {
	local bank mode out
	json_load "$1"
	json_get_var bank bank
	json_get_var mode mode
	case "$bank" in 0|1) ;; *) err "bank must be 0 or 1" ;; esac
	case "$mode" in
		try) out=$(/usr/sbin/nijika boot try "$bank" 2>&1) ;;
		*) out=$(/usr/sbin/nijika boot "$bank" 2>&1) ;;
	esac
	json_init
	json_add_boolean ok 1
	json_add_string message "$out"
	json_dump
}

m_fw_check() {
	local msg
	json_init
	if msg=$(fw_check "$FW_PATH" 2>&1); then
		json_add_boolean valid 1
		json_add_string format "$FW_FMT"
		json_add_string version "$(fw_version "$FW_PATH")"
		json_add_int size "$(wc -c < "$FW_PATH")"
		fw_target_info
		json_add_int target "$FW_TARGET"
		json_add_string target_version "$FW_TARGET_VER"
		json_add_boolean target_stock "$FW_TARGET_STOCK"
	else
		json_add_boolean valid 0
		json_add_string message "$msg"
	fi
	json_dump
}

m_fw_flash() {
	local mode replace msg
	json_load "$1"
	json_get_var mode mode
	json_get_var replace replace_stock
	case "$mode" in commit) ;; none) ;; *) mode=try ;; esac
	[ -f "$FW_PATH" ] || err "no firmware uploaded"
	msg=$(fw_check_target "${replace:-0}" 2>&1) || err "$msg"
	rm -f "$FW_RC"
	(
		. /usr/lib/nijika/common.sh
		. /usr/lib/nijika/fw.sh
		fw_flash "$FW_PATH" "$mode" > "$FW_LOG" 2>&1
		echo $? > "$FW_RC"
		rm -f "$FW_PATH"
	) </dev/null >/dev/null 2>&1 &
	json_init
	json_add_boolean started 1
	json_dump
}

m_fw_status() {
	json_init
	if [ -f "$FW_RC" ]; then
		json_add_boolean running 0
		json_add_int rc "$(cat "$FW_RC")"
	else
		json_add_boolean running "$([ -f "$FW_LOG" ] && echo 1 || echo 0)"
	fi
	json_add_string log "$(cat "$FW_LOG" 2>/dev/null)"
	json_dump
}

m_reboot() {
	( sleep 2; reboot ) </dev/null >/dev/null 2>&1 &
	echo '{"ok":true}'
}


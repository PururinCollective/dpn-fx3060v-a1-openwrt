IDENT_KEYS="PON_VENDOR_ID GPON_ONU_MODEL HW_CWMP_PRODUCTCLASS HW_CWMP_MANUFACTURER HW_HWVER OMCI_OLT_MODE OMCI_SW_VER1 OMCI_SW_VER2 OMCI_VENDOR_PRODUCT_CODE OMCI_TM_OPT OUI HW_SERIAL_NO OMCI_CUSTOM_BDP OMCI_CUSTOM_RDP OMCI_CUSTOM_ME"

m_ident_get() {

#!/bin/sh
# rpcd backend for luci-app-nijika (ubus object "nijika").
# Bridges LuCI to the stock Realtek tools in the /rtk vendor chroot.

. /usr/share/libubox/jshn.sh
. /usr/lib/nijika/common.sh
. /usr/lib/nijika/omci.sh
. /usr/lib/nijika/pon.sh
. /usr/lib/nijika/fw.sh
. /usr/lib/nijika/apply.sh
. /usr/lib/nijika/qos.sh

FW_PATH=/tmp/nijika-fw.bin
FW_LOG=/tmp/nijika-fw.log
FW_RC=/tmp/nijika-fw.rc

err() {
	json_init
	json_add_string error "$1"
	json_dump
	exit 0
}

need_vendor() {
	vendor_up || err "vendor stack is not running"
}

# --- small readers ---------------------------------------------------------

voip_get() { # field chid proxy
	rtk /bin/voipflashcmd get "$1" "$2" "$3" 2>/dev/null | sed -n "s/^$1: //p" | head -n 1
}

chain_field() { # table index field
	mib_get "$1.$2.$3"
}

# --- methods ---------------------------------------------------------------

m_status() {
	need_vendor
	pon_cached_env | pon_env_to_json
}

m_olt() {
	need_vendor
	/usr/sbin/nijika olt --json
}

m_me() {
	need_vendor
	local class
	json_load "$1"
	json_get_var class class
	case "$class" in ''|*[!0-9]*) err "invalid ME class" ;; esac
	omci_me_json "$class"
}

# Provider set-up for the Provisioning page: the OMCI MEs of the data path
# plus omci_app's own queue map, cached for OMCI_MAP_TTL seconds.
m_provision() {
	need_vendor
	local out
	out=$(omci_map_json)
	[ -n "$out" ] || err "OMCI data not available"
	printf '%s\n' "$out"
}

m_diag() {
	need_vendor
	local cmd out
	json_load "$1"
	json_get_var cmd cmd
	case "$cmd" in
		# RTL9607DQ: GPON state and flows live under "diag rt_gpon"
		onu-state)   out=$(pon_onu_state_raw) ;;
		counters)    out=$(for k in phy plm omci gem; do
		                     diag rt_gpon show counter global "$k"; done) ;;
		transceiver) out=$(for k in temperature voltage bias-current tx-power rx-power; do
		                     diag pon get transceiver "$k"; done) ;;
		onu-info)    out=$(diag rt_gpon get dbru-status; diag rt_gpon show omcc
		                     diag rt_gpon show tcont) ;;
		us-flow)     out=$(diag rt_gpon show us-flow) ;;
		ds-flow)     out=$(diag rt_gpon show ds-flow) ;;
		interfaces)  out=$(rtk /bin/ifconfig) ;;
		routes)      out=$(rtk /bin/ip route; echo; rtk /bin/ip -6 route) ;;
		nat)         out=$(rtk /bin/iptables -t nat -S) ;;
		filter)      out=$(rtk /bin/iptables -S) ;;
		bridge)      out=$(rtk /bin/brctl show) ;;
		ppp)         out=$(cat /rtk/var/ppp/* 2>/dev/null; rtk /bin/ip addr show dev ppp0 2>&1) ;;
		vendor-boot) out=$(logread -e rtk 2>/dev/null | tail -n 200) ;;
		*) err "command not allowed" ;;
	esac
	printf '{"cmd":"%s","output":"%s"}\n' "$cmd" "$(printf '%s' "$out" | json_escape)"
}

m_mib_all() {
	need_vendor
	local tmp=/tmp/.nijika_mib_all.$$
	rtk /bin/flash all > "$tmp" 2>/dev/null
	printf '{"values":'
	awk -f "$NIJIKA_LIB/kv.awk" "$tmp" | tr -d '\n'
	# "MIB Chain Information" header: "  ID Name   size/record   Num   Max"
	printf ',"chains":['
	awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[A-Z0-9_]+_TBL$/ && NF >= 5 && !seen[$2]++ {
		printf "%s{\"id\":%d,\"name\":\"%s\",\"num\":%d,\"max\":%d}", (n++ ? "," : ""), $1, $2, $(NF-1), $NF
	}' "$tmp"
	printf ']}\n'
	rm -f "$tmp"
}

m_mib_get() {
	need_vendor
	local keys k
	json_load "$1"
	json_get_values keys keys
	json_init
	json_add_object values
	for k in $keys; do
		json_add_string "$k" "$(mib_get "$k")"
	done
	json_close_object
	json_dump
}

# apply_detached AREA...: apply after the reply went out (a WiFi or WAN
# restart can outlast the LuCI call)
apply_detached() {
	[ $# -gt 0 ] || return 0
	( sleep 1; apply_after "$@" ) </dev/null >/dev/null 2>&1 &
}

# reply fields: applied areas, reboot_required
json_add_apply() {
	local a reboot=0 live=""
	if apply_enabled; then
		for a in "$@"; do [ "$a" = reboot ] && reboot=1 || live="$live $a"; done
	else
		[ $# -gt 0 ] && reboot=1
	fi
	json_add_array applied
	for a in $live; do json_add_string "" "$a"; done
	json_close_array
	json_add_boolean reboot_required "$reboot"
}

# {"values": [["KEY","VALUE"], ...]}
m_mib_set() {
	need_vendor
	local i n k v ok=0 failed="" keys="" vals="$NIJIKA_RUNDIR/mib_set.$$" areas
	json_load "$1"
	json_select values || err "values missing"
	json_get_keys n
	mkdir -p "$NIJIKA_RUNDIR"
	: > "$vals"
	for i in $n; do
		json_select "$i"
		json_get_var k 1
		json_get_var v 2
		json_select ..
		case "$k" in ''|*[!A-Za-z0-9_.]*) failed="$failed $k"; continue ;; esac
		printf '%s\n%s\n' "$k" "$v" >> "$vals"
		keys="$keys $k"
	done
	areas=$(printf '%s\n' $keys | apply_areas)
	apply_before $areas
	while IFS= read -r k && IFS= read -r v; do
		if rtk /bin/flash set "$k" "$v" >/dev/null 2>&1; then ok=$((ok + 1)); else failed="$failed $k"; fi
	done < "$vals"
	rm -f "$vals"
	apply_detached $areas
	json_init
	json_add_int ok "$ok"
	json_add_array failed
	for k in $failed; do json_add_string "" "$k"; done
	json_close_array
	json_add_apply $areas
	json_dump
}

m_chain() {
	need_vendor
	local table
	json_load "$1"
	json_get_var table table
	case "$table" in ''|*[!A-Z0-9_]*) err "invalid table" ;; esac
	rtk /bin/flash get "$table" 2>/dev/null | awk -v table="$table" -f "$NIJIKA_LIB/chain.awk"
}

# --- Quick Setup -----------------------------------------------------------

wifi_radio() { # idx(0|1) -> object
	local p chain band
	if [ "$1" = 0 ]; then p=""; chain=WLAN_MBSSIB_TBL; band=$(mib_get WLAN_PHY_BAND_SELECT)
	else p=WLAN1_; chain=WLAN1_MBSSIB_TBL; band=$(mib_get WLAN1_PHY_BAND_SELECT); fi
	local ssid psk dis
	ssid=$(chain_field "$chain" 0 ssid); [ -n "$ssid" ] || ssid=$(mib_get "${p}SSID")
	psk=$(chain_field "$chain" 0 wpaPSK); [ -n "$psk" ] || psk=$(mib_get "${p:-WLAN_}WPA_PSK")
	dis=$(mib_get "${p:-WLAN_}DISABLED")
	json_add_object
	json_add_int radio "$1"
	json_add_string band "$([ "$band" = 2 ] && echo 5g || echo 2g)"
	json_add_string ssid "$ssid"
	json_add_string key "$psk"
	json_add_boolean enabled "$([ "$dis" = 1 ] && echo 0 || echo 1)"
	json_close_object
}

m_quick_get() {
	need_vendor
	local chid
	json_init

	json_add_object pon
	json_add_string sn "$(mib_get GPON_SN)"
	json_add_string ploam "$(mib_get GPON_PLOAM_PASSWD)"
	json_add_string loid "$(mib_get LOID)"
	json_add_string loid_pw "$(mib_get LOID_PASSWD)"
	json_close_object

	json_add_array wifi
	wifi_radio 0
	wifi_radio 1
	json_close_array

	json_add_array voip
	for chid in 0 1; do
		json_add_object
		json_add_int line "$chid"
		json_add_boolean enable "$(voip_get enable "$chid" 0 | grep -q '^1' && echo 1 || echo 0)"
		json_add_string addr "$(voip_get addr "$chid" 0)"
		json_add_string port "$(voip_get port "$chid" 0)"
		json_add_string domain "$(voip_get domain_name "$chid" 0)"
		json_add_string number "$(voip_get number "$chid" 0)"
		json_add_string login "$(voip_get login_id "$chid" 0)"
		json_add_string password "$(voip_get password "$chid" 0)"
		json_add_string display "$(voip_get display_name "$chid" 0)"
		json_close_object
	done
	json_close_array

	json_dump | sed 's/}$//'
	# WAN records come straight from the chain parser.
	printf ',"wan":'
	rtk /bin/flash get ATM_VC_TBL 2>/dev/null | awk -v table=ATM_VC_TBL -f "$NIJIKA_LIB/chain.awk" | tr -d '\n'
	printf ',"isp":['
	grep -v '^#' "$NIJIKA_SHARE/isp-presets.tsv" | awk -F'\t' '
		{ printf "%s{\"id\":\"%s\",\"label\":\"%s\",\"vid\":%d,\"prio\":%d,\"mtu\":%d}", (n++ ? "," : ""), $1, $2, $3, $4, $5 }'
	printf ']}\n'
}

# Quick Setup writes go through qs_set: it remembers the keys for the apply
# step. A WAN record is taken down with its old settings before the first
# write to it (apply_before), as the stock WAN form does.
QS_KEYS=""
QS_WAN=""
QS_VOIP=0
qs_set() { # key value
	case "$1" in
		ATM_VC_TBL.*)
			local n=${1#ATM_VC_TBL.}; n=${n%%.*}
			case " $QS_WAN " in *" $n "*) ;; *) QS_WAN="$QS_WAN $n"; apply_before "wan:$n" ;; esac ;;
	esac
	mib_set "$1" "$2" && QS_KEYS="$QS_KEYS $1"
}

set_if() { # key value  (only when a value is given and it differs)
	[ -n "$2" ] || return 0
	[ "$(mib_get "$1")" = "$2" ] && return 0
	qs_set "$1" "$2"
}

m_quick_set() {
	need_vendor
	local v idx user pass vid prio mtu i radio ssid key chain p line
	json_load "$1"

	# PON authentication
	if json_select pon 2>/dev/null; then
		json_get_var v sn; set_if GPON_SN "$v"
		json_get_var v ploam; json_get_var p ploam_set
		[ "$p" = 1 ] && [ "$(mib_get GPON_PLOAM_PASSWD)" != "$v" ] && qs_set GPON_PLOAM_PASSWD "$v"
		json_get_var v loid; json_get_var p loid_set
		[ "$p" = 1 ] && [ "$(mib_get LOID)" != "$v" ] && qs_set LOID "$v"
		json_get_var v loid_pw
		[ "$p" = 1 ] && [ "$(mib_get LOID_PASSWD)" != "$v" ] && qs_set LOID_PASSWD "$v"
		json_select ..
	fi

	# Internet WAN (PPPoE): always connection #0, the ISP/stock default
	if json_select wan 2>/dev/null; then
		idx=0
		json_get_var user user
		json_get_var pass pass
		json_get_var vid vid
		json_get_var prio prio
		json_get_var mtu mtu
		case "$idx" in ''|*[!0-9]*) ;; *)
			set_if "ATM_VC_TBL.$idx.pppUser" "$user"
			set_if "ATM_VC_TBL.$idx.pppPasswd" "$pass"
			if [ -n "$vid" ] && [ "$vid" -gt 0 ] 2>/dev/null; then
				set_if "ATM_VC_TBL.$idx.vlan" 1
				set_if "ATM_VC_TBL.$idx.vid" "$vid"
			elif [ "$vid" = 0 ]; then
				set_if "ATM_VC_TBL.$idx.vlan" 0
			fi
			set_if "ATM_VC_TBL.$idx.vprio" "$prio"
			set_if "ATM_VC_TBL.$idx.MTU" "$mtu"
			;;
		esac
		json_select ..
	fi

	# WiFi: write both the root BSS chain record and the legacy scalars.
	if json_select wifi 2>/dev/null; then
		json_get_keys i
		for line in $i; do
			json_select "$line"
			json_get_var radio radio
			json_get_var ssid ssid
			json_get_var key key
			json_select ..
			if [ "$radio" = 0 ]; then chain=WLAN_MBSSIB_TBL; p=""; else chain=WLAN1_MBSSIB_TBL; p=WLAN1_; fi
			if [ -n "$ssid" ]; then
				set_if "$chain.0.ssid" "$ssid"
				set_if "${p}SSID" "$ssid"
			fi
			if [ -n "$key" ]; then
				[ ${#key} -ge 8 ] && [ ${#key} -le 64 ] || err "WiFi key must be 8..64 characters"
				set_if "$chain.0.wpaPSK" "$key"
				set_if "${p:-WLAN_}WPA_PSK" "$key"
			fi
		done
		json_select ..
	fi

	# VoIP lines (primary proxy)
	if json_select voip 2>/dev/null; then
		json_get_keys i
		for line in $i; do
			json_select "$line"
			local chid en addr port dom num login pw disp
			json_get_var chid line
			json_get_var en enable
			json_get_var addr addr
			json_get_var port port
			json_get_var dom domain
			json_get_var num number
			json_get_var login login
			json_get_var pw password
			json_get_var disp display
			json_select ..
			case "$chid" in 0|1) ;; *) continue ;; esac
			QS_VOIP=1
			rtk /bin/voipflashcmd set enable "${en:-0}" "$chid" 0 >/dev/null 2>&1
			# A disabled line keeps its stored account (fields are hidden in the UI).
			[ "$en" = 1 ] || continue
			[ -n "$addr" ] && rtk /bin/voipflashcmd set addr "$addr" "$chid" 0 >/dev/null 2>&1
			[ -n "$port" ] && rtk /bin/voipflashcmd set port "$port" "$chid" 0 >/dev/null 2>&1
			rtk /bin/voipflashcmd set domain_name "$dom" "$chid" 0 >/dev/null 2>&1
			rtk /bin/voipflashcmd set number "$num" "$chid" 0 >/dev/null 2>&1
			rtk /bin/voipflashcmd set login_id "$login" "$chid" 0 >/dev/null 2>&1
			[ -n "$pw" ] && rtk /bin/voipflashcmd set password "$pw" "$chid" 0 >/dev/null 2>&1
			rtk /bin/voipflashcmd set display_name "$disp" "$chid" 0 >/dev/null 2>&1
		done
		json_select ..
	fi

	local areas
	areas=$(printf '%s\n' $QS_KEYS | apply_areas)
	[ "$QS_VOIP" = 1 ] && areas="${areas:+$areas }voip"
	apply_detached $areas
	json_init
	json_add_boolean ok 1
	json_add_apply $areas
	json_dump
}

# --- VoIP ------------------------------------------------------------------

# Per line (CHID 0/1) and proxy (0 primary, 1 backup): the keys the stock
# voipflashcmd knows (stock GUI: VoIP > Port1/Port2).
VOIP_KEYS="enable display_name number login_id password addr port domain_name"

m_voip_get() {
	need_vendor
	local chid proxy k
	json_init
	json_add_array lines
	for chid in 0 1; do
		json_add_object
		json_add_int line "$chid"
		json_add_array proxies
		for proxy in 0 1; do
			json_add_object
			for k in $VOIP_KEYS; do
				json_add_string "$k" "$(voip_get "$k" "$chid" "$proxy")"
			done
			json_close_object
		done
		json_close_array
		json_close_object
	done
	json_close_array
	json_dump
}

# {"values": [["key","value",chid,proxy], ...]}
m_voip_set() {
	need_vendor
	local i n k v c p ok=0 failed=""
	json_load "$1"
	json_select values || err "values missing"
	json_get_keys n
	for i in $n; do
		json_select "$i"
		json_get_var k 1
		json_get_var v 2
		json_get_var c 3
		json_get_var p 4
		json_select ..
		case " $VOIP_KEYS " in *" $k "*) ;; *) failed="$failed $k"; continue ;; esac
		case "$c$p" in [01][01]) ;; *) failed="$failed $k"; continue ;; esac
		if rtk /bin/voipflashcmd set "$k" "$v" "$c" "$p" >/dev/null 2>&1; then ok=$((ok + 1)); else failed="$failed $k"; fi
	done
	[ $ok -gt 0 ] && apply_detached voip
	json_init
	json_add_int ok "$ok"
	json_add_array failed
	for k in $failed; do json_add_string "" "$k"; done
	json_close_array
	if [ $ok -gt 0 ]; then json_add_apply voip; else json_add_apply; fi
	json_dump
}

# --- WiFi: WPS, EasyMesh ------------------------------------------------------

# {"radio": 0|1, "action": "pbc"|"pin"|"cancel", "pin": "..."}: the stock WPS
# page (formWsc with hostapd): push button, or a client's PIN, on the main
# SSID of the radio
m_wps() {
	need_vendor
	local radio action pin ifn out ok=0
	json_load "$1"
	json_get_var radio radio
	json_get_var action action
	json_get_var pin pin
	case "$radio" in 0|1) ifn=wlan$radio ;; *) err "no radio $radio" ;; esac
	case "$action" in
		pbc)
			out=$(rtk /bin/hostapd_cli wps_pbc -i "$ifn" 2>&1)
			case "$out" in *OK*) ok=1 ;; esac ;;
		pin)
			case "$pin" in
				[0-9][0-9][0-9][0-9]|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
				*) err "the PIN has 4 or 8 digits" ;;
			esac
			# hostapd answers with the PIN it accepted
			out=$(rtk /bin/hostapd_cli wps_pin any "$pin" -i "$ifn" 2>&1)
			case "$out" in *"$pin"*) ok=1 ;; esac ;;
		cancel)
			out=$(rtk /bin/hostapd_cli wps_cancel -i "$ifn" 2>&1)
			case "$out" in *OK*) ok=1 ;; esac ;;
		*) err "unknown action" ;;
	esac
	logger -t nijika-wps "$ifn: $action"
	json_init
	if [ $ok = 1 ]; then json_add_boolean ok 1; else json_add_string error "${out:-no answer from hostapd}"; fi
	json_dump
}

# EasyMesh, the stock WLAN > EasyMesh page (formMultiAP): MAP_CONTROLLER
# 0 disabled, 1 controller, 2 agent, 3 auto (D-Link: the role is picked
# when pairing)
easymesh_role() {
	case "$(mib_get MAP_CONTROLLER)" in
		1) echo controller ;; 2) echo agent ;; 3) echo auto ;; *) echo disabled ;;
	esac
}

m_easymesh_get() {
	need_vendor
	local d
	json_init
	json_add_string role "$(easymesh_role)"
	json_add_string pinned "$(uci -q get nijika.vendor.easymesh || echo controller)"
	json_add_string name "$(mib_get MAP_DEVICE_NAME)"
	json_add_array running
	for d in map_controller map_agent map_checker; do
		pidof "$d" >/dev/null && json_add_string "" "$d"
	done
	json_close_array
	json_dump
}

# {"role": "disabled"|"controller"|"auto", "backhaul": "0"|"1"|"3", "name": ""}
# The agent role (a mesh satellite: the LAN becomes a DHCP client) makes no
# sense on the gateway and is not offered; auto is the D-Link/TM default
# that becomes one without fibre (see /usr/libexec/rtk/easymesh-pin). The
# choice is also kept in nijika.vendor.easymesh, which boot pins.
m_easymesh_set() {
	need_vendor
	local role backhaul name prev t i
	json_load "$1"
	json_get_var role role
	json_get_var backhaul backhaul
	json_get_var name name
	case "$role" in disabled|controller|auto) ;; *) err "role: disabled, controller or auto" ;; esac
	: "${backhaul:=3}"
	case "$backhaul" in 0|1|3) ;; *) err "backhaul: 0 (5 GHz), 1 (2.4 GHz) or 3 (auto)" ;; esac
	prev=$(easymesh_role)
	uci -q set nijika.vendor.easymesh="$role" && uci -q commit nijika
	[ -n "$name" ] && mib_set MAP_DEVICE_NAME "$name"
	# formMultiAP needEnable11kv: EasyMesh steers clients with 802.11k/v
	if [ "$role" != disabled ]; then
		for t in WLAN_MBSSIB_TBL WLAN1_MBSSIB_TBL; do
			for i in 0 1 2 3 4; do
				mib_set "$t.$i.rm_activated" 1
				mib_set "$t.$i.BssTransEnable" 1
			done
		done
	fi
	( sleep 1; rtk_apply easymesh "$role" "$prev" "$backhaul" ) </dev/null >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_add_apply wlan
	json_dump
}

# Pairing button (formMultiAP start_wsc) of the controller. In the auto
# role the device's own WPS button does it the D-Link way (controller with
# fibre, mesh node without).
m_easymesh_pair() {
	need_vendor
	[ "$(easymesh_role)" = controller ] || err "pairing from here needs the controller role"
	( sleep 1; rtk_apply easymesh-pair ) </dev/null >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_dump
}

# --- Port forwarding (stock Firewall > Port Forwarding, formPortFw) ---------

# chain size of a stock table, from the "MIB Chain Information" of flash all
chain_max() {
	rtk /bin/flash all 2>/dev/null | awk -v t="$1" '$1 ~ /^[0-9]+$/ && $2 == t { print $NF; exit }'
}

m_portfw_get() {
	need_vendor
	local en max
	en=false; [ "$(mib_get PORT_FW_ENABLE)" = 1 ] && en=true
	max=$(chain_max PORT_FW_TBL)
	printf '{"enable":%s,"max":%d,"chain":' "$en" "${max:-0}"
	rtk /bin/flash get PORT_FW_TBL 2>/dev/null | awk -v table=PORT_FW_TBL -f "$NIJIKA_LIB/chain.awk" | tr -d '\n'
	printf '}\n'
}

is_ip4() {
	echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	local IFS=. o
	for o in $1; do [ "$o" -le 255 ] || return 1; done
}

is_port() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# {"enable": bool, "rules": [{"enable", "comment", "ip", "efrom", "eto"
#  (the WAN port(s), required: libmib matches --dport on them), "from", "to"
#  (internal ports; none: the external ones), "proto" (1 TCP, 2 UDP, 3 both:
#  D-Link stores "both" as 3), "rhost", "ifindex" (65535 = any WAN)}]}
# Replaces the static rules; UPnP's (Dynamic=1) stay. Records go in with the
# stock `flash add/del/set`, committed before the reply (the page reads them
# back from flash), then setupPortFW like the stock page.
m_portfw_set() {
	need_vendor
	local en n i k total idx out vals="$NIJIKA_RUNDIR/portfw.$$" ok=0
	local r_en r_comment r_ip r_from r_to r_proto r_rhost r_efrom r_eto r_if
	json_load "$1"
	json_get_var en enable
	json_select rules || err "rules missing"
	json_get_keys n
	mkdir -p "$NIJIKA_RUNDIR"
	: > "$vals"
	for i in $n; do
		json_select "$i"
		json_get_var r_en enable; json_get_var r_comment comment; json_get_var r_ip ip
		json_get_var r_from from; json_get_var r_to to; json_get_var r_proto proto
		json_get_var r_rhost rhost; json_get_var r_efrom efrom; json_get_var r_eto eto
		json_get_var r_if ifindex
		json_select ..
		r_comment=$(printf '%s' "$r_comment" | tr -d '\000-\037' | cut -c1-59)
		: "${r_eto:=$r_efrom}" "${r_if:=65535}" "${r_rhost:=0.0.0.0}"
		is_ip4 "$r_ip" || { rm -f "$vals"; err "rule $((i)): internal address"; }
		is_port "$r_efrom" && is_port "$r_eto" && [ "$r_eto" -ge "$r_efrom" ] || { rm -f "$vals"; err "rule $((i)): external port"; }
		# no internal port: the external one (the FORWARD accept rule then
		# covers only that port; 0 would accept every port)
		case "${r_from:-0}" in 0) r_from=$r_efrom r_to=$r_eto ;; esac
		: "${r_to:=$r_from}"
		is_port "$r_from" && is_port "$r_to" && [ "$r_to" -ge "$r_from" ] || { rm -f "$vals"; err "rule $((i)): internal port"; }
		case "$r_proto" in 1|2|3) ;; *) rm -f "$vals"; err "rule $((i)): protocol" ;; esac
		is_ip4 "$r_rhost" || { rm -f "$vals"; err "rule $((i)): source address"; }
		case "$r_if" in ''|*[!0-9]*) rm -f "$vals"; err "rule $((i)): WAN" ;; esac
		case "$r_en" in 1|true) r_en=1 ;; *) r_en=0 ;; esac
		printf '%s\n' "IP=$r_ip" "PortStart=$r_from" "PortEnd=$r_to" "Protocol=$r_proto" "Comment=$r_comment" \
			"OutInf=$r_if" "enable=$r_en" "remotehost=$r_rhost" "externalportStart=$r_efrom" \
			"externalportEnd=$r_eto" "--" >> "$vals"
	done

	# drop the static rules, last first (indexes shift)
	total=$(rtk /bin/flash get PORT_FW_TBL.NUM 2>/dev/null | sed -n 's/.*NUM=//p')
	i=$(( ${total:-0} - 1 ))
	while [ $i -ge 0 ]; do
		[ "$(mib_get "PORT_FW_TBL.$i.Dynamic")" = 1 ] || rtk /bin/flash del "PORT_FW_TBL.$i" >/dev/null 2>&1
		i=$((i - 1))
	done
	# add the new ones
	idx=
	while IFS= read -r k; do
		if [ "$k" = -- ]; then idx=; ok=$((ok + 1)); continue; fi
		if [ -z "$idx" ]; then
			out=$(rtk /bin/flash add PORT_FW_TBL 2>/dev/null | sed -n 's/.*NUM=//p')
			[ -n "$out" ] || { rm -f "$vals"; err "the stock table is full after $ok rule(s)"; }
			idx=$((out - 1))
		fi
		mib_set "PORT_FW_TBL.$idx.${k%%=*}" "${k#*=}"
	done < "$vals"
	rm -f "$vals"
	mib_set PORT_FW_ENABLE "$( [ "$en" = 1 ] || [ "$en" = true ] && echo 1 || echo 0)"
	# configd keeps writes in RAM and `flash get` reads flash: without the
	# commit the page's reload would still show the old switch and rules
	rtk /bin/mib commit cs now >/dev/null 2>&1
	apply_detached portfw
	json_init
	json_add_int ok "$ok"
	json_add_apply portfw
	json_dump
}

# --- QoS (stock Advance > Upstream / Downstream QoS Policy, QoS -------------
# Classification, Traffic Shaping; /usr/lib/nijika/qos.sh)

QOS_TABLES="IP_QOS_QUEUE_TBL IP_QOS_DOWNSTREAM_QUEUE_TBL IP_QOS_TBL IP_QOS_TC_TBL"

# qos_flash_set KEY VALUE...: one stock `flash set`; it exits 0 even for a
# key it refuses, but prints "set KEY=VALUE" for each one it took
qos_flash_set() {
	[ "$(rtk /bin/flash set "$@" 2>/dev/null | grep -c '^set ')" = $(($# / 2)) ]
}

# {"mib": {KEY: value} (QOS_KEYS), "queues", "dqueues", "rules", "tc": chain
#  JSON ({"num", "records"}), "rules_max", "tc_max": the tables' sizes}
m_qos_get() {
	need_vendor
	local all="$NIJIKA_RUNDIR/qos_all.$$" t sep=
	mkdir -p "$NIJIKA_RUNDIR"
	rtk /bin/flash all > "$all" 2>/dev/null
	printf '{"mib":{'
	for t in $QOS_KEYS; do
		printf '%s"%s":"%s"' "$sep" "$t" "$(sed -n "s/^$t=//p" "$all" | head -n 1 | tr -cd '0-9')"
		sep=,
	done
	printf '},"rules_max":%d,"tc_max":%d' \
		"$(awk '$1 ~ /^[0-9]+$/ && $2 == "IP_QOS_TBL" { print $NF; exit }' "$all")" \
		"$(awk '$1 ~ /^[0-9]+$/ && $2 == "IP_QOS_TC_TBL" { print $NF; exit }' "$all")"
	rm -f "$all"
	set -- queues dqueues rules tc
	for t in $QOS_TABLES; do
		printf ',"%s":' "$1"
		rtk /bin/flash get "$t" 2>/dev/null | awk -v table="$t" -f "$NIJIKA_LIB/chain.awk" | tr -d '\n'
		shift
	done
	printf '}\n'
}

# qos_chain_rewrite TABLE FILE: the records of TABLE become the ones in FILE
# ("Field=value" lines, "--" after each record), with the stock `flash
# del/add/set` (TM build: through configd)
qos_chain_rewrite() {
	local t="$1" num idx rec="" kv
	rtk /bin/mib commit cs now >/dev/null 2>&1
	num=$(rtk /bin/flash get "$t.NUM" 2>/dev/null | sed -n 's/.*NUM=//p')
	while [ "${num:-0}" -gt 0 ]; do
		rtk /bin/flash del "$t" >/dev/null 2>&1
		num=$((num - 1))
	done
	while IFS= read -r kv; do
		if [ "$kv" != -- ]; then
			rec="$rec$kv
"
			continue
		fi
		idx=$(rtk /bin/flash add "$t" 2>/dev/null | sed -n 's/.*NUM=//p')
		[ -n "$idx" ] || return 1
		idx=$((idx - 1))
		set --
		while IFS= read -r kv; do
			[ -n "$kv" ] && set -- "$@" "$t.$idx.${kv%%=*}" "${kv#*=}"
		done <<EOF
$rec
EOF
		qos_flash_set "$@" || return 1
		rec=""
	done < "$2"
}

# {"mib": {KEY: value}, "queues": [{"enable", "weight", "car"}] (8),
#  "dqueues": [{"enable", "weight", "wifi"}] (8), "rules": [...], "tc": [...]}
# Each part is optional; "rules" / "tc" replace the whole table (fields: the
# r_* names of qos_rule_fields / qos_tc_fields without "r_"). Everything is
# checked before anything is written. Then, like the stock forms: stopIPQ,
# the writes, Commit, take_qos_effect.
m_qos_set() {
	need_vendor
	local k v i n keys sets="" policy dpolicy dir="$NIJIKA_RUNDIR/qos_set.$$" t part tbl qpol
	local r_enable r_weight r_car r_wifi r_name r_direction r_ipver r_classtype r_conntype r_phyport r_proto
	local r_dscp r_vlan1p r_outif r_sip r_smask r_dip r_dmask r_sip6 r_sip6len r_dip6 r_dip6len r_sport
	local r_sport_end r_dport r_dport_end r_smac r_dmac r_prio r_mdscp r_m1p r_order r_entryid r_ifindex r_rate
	json_load "$1"
	rm -rf "$dir"
	mkdir -p "$dir"
	if json_select mib 2>/dev/null; then
		json_get_keys keys
		for k in $keys; do
			json_get_var v "$k"
			qos_mib_ok "$k" "$v" || { rm -rf "$dir"; err "$k: invalid value"; }
			sets="$sets $k $v"
		done
		json_select ..
	fi
	policy=$(echo "$sets" | awk '{ for (i = 1; i < NF; i += 2) if ($i == "QOS_POLICY") print $(i + 1) }')
	dpolicy=$(echo "$sets" | awk '{ for (i = 1; i < NF; i += 2) if ($i == "QOS_DOWNSTREAM_POLICY") print $(i + 1) }')
	: "${policy:=$(mib_get QOS_POLICY)}" "${dpolicy:=$(mib_get QOS_DOWNSTREAM_POLICY)}"
	for part in queues:IP_QOS_QUEUE_TBL:up dqueues:IP_QOS_DOWNSTREAM_QUEUE_TBL:down; do
		t=${part%%:*} tbl=${part#*:} tbl=${tbl%:*}
		json_select "$t" 2>/dev/null || continue
		json_get_keys n
		[ "${part##*:}" = up ] && qpol=$policy || qpol=$dpolicy
		i=0
		for k in $n; do
			[ $i -lt 8 ] || break
			json_select "$k"
			r_enable= r_weight= r_car= r_wifi=
			json_get_var r_enable enable; json_get_var r_weight weight
			json_get_var r_car car; json_get_var r_wifi wifi
			json_select ..
			qos_queue_fields "${part##*:}" "$qpol" > "$dir/q" 2> "$dir/err" ||
				{ v=$(cat "$dir/err"); rm -rf "$dir"; err "Q$((i + 1)): $v"; }
			sed "s/^/$tbl.$i./" "$dir/q" >> "$dir/queues"
			i=$((i + 1))
		done
		json_select ..
	done
	if json_select rules 2>/dev/null; then
		json_get_keys n
		set -- $n
		: > "$dir/rules"
		i=0
		for k in $n; do
			json_select "$k"
			for v in name direction ipver classtype conntype phyport proto dscp vlan1p outif sip smask dip dmask \
				sip6 sip6len dip6 dip6len sport sport_end dport dport_end smac dmac prio mdscp m1p; do
				eval "r_$v="
				json_get_var "r_$v" "$v"
			done
			json_select ..
			r_order=$(($# - 1 - i))
			qos_rule_fields >> "$dir/rules" 2> "$dir/err" ||
				{ v=$(cat "$dir/err"); rm -rf "$dir"; err "rule $((i + 1)): $v"; }
			echo -- >> "$dir/rules"
			i=$((i + 1))
		done
		json_select ..
	fi
	if json_select tc 2>/dev/null; then
		json_get_keys n
		: > "$dir/tc"
		i=0
		for k in $n; do
			json_select "$k"
			for v in ipver direction proto ifindex sip smask dip dmask sip6 sip6len dip6 dip6len sport dport rate; do
				eval "r_$v="
				json_get_var "r_$v" "$v"
			done
			json_select ..
			r_entryid=$((i + 1))
			qos_tc_fields >> "$dir/tc" 2> "$dir/err" ||
				{ v=$(cat "$dir/err"); rm -rf "$dir"; err "rule $((i + 1)): $v"; }
			echo -- >> "$dir/tc"
			i=$((i + 1))
		done
		json_select ..
	fi

	apply_before qos
	# shellcheck disable=SC2086 # key value pairs
	[ -z "$sets" ] || qos_flash_set $sets || { rm -rf "$dir"; err "writing the QoS settings failed"; }
	if [ -s "$dir/queues" ]; then
		set --
		while IFS= read -r v; do set -- "$@" "${v%%=*}" "${v#*=}"; done < "$dir/queues"
		qos_flash_set "$@" || { rm -rf "$dir"; err "writing the queue settings failed"; }
	fi
	[ ! -f "$dir/rules" ] || qos_chain_rewrite IP_QOS_TBL "$dir/rules" || { rm -rf "$dir"; err "the stock classification table is full or refused a rule"; }
	[ ! -f "$dir/tc" ] || qos_chain_rewrite IP_QOS_TC_TBL "$dir/tc" || { rm -rf "$dir"; err "the stock traffic control table is full or refused a rule"; }
	rm -rf "$dir"
	rtk /bin/mib commit cs now >/dev/null 2>&1
	apply_detached qos
	json_init
	json_add_boolean ok 1
	json_add_apply qos
	json_dump
}

# --- WAN status (stock Status > Device Status, WAN table) ------------------

# One line per WAN connection: rec|ifIndex|ChannelMode|ChannelStatus|vlan|vid|
# applicationtype|ChannelAddrType|DefaultGW|IpProtocol
wan_records() {
	rtk /bin/flash get ATM_VC_TBL 2>/dev/null | awk '
		function out() { print idx "|" f["ifIndex"] "|" f["ChannelMode"] "|" f["ChannelStatus"] "|" f["vlan"] "|" \
			f["vid"] "|" f["applicationtype"] "|" f["ChannelAddrType"] "|" f["DefaultGW"] "|" f["IpProtocol"] }
		{ sub(/\r$/, "") }
		/^ATM_VC_TBL\.[0-9]+:$/ { if (n++) out(); split("", f); idx = $0; sub(/^ATM_VC_TBL\./, "", idx); sub(/:$/, "", idx); next }
		n && /=/ { p = index($0, "="); k = substr($0, 1, p - 1); v = substr($0, p + 1)
			sub(/^[ \t]+/, "", k); sub(/[ \t]+$/, "", k); sub(/^ /, "", v); f[k] = v }
		END { if (n) out() }'
}

m_wan_status() {
	need_vendor
	local rec ifi cm st vl vid app at dgw ipp ppp vc ifn ip4 gw4 ip6 state line
	json_init
	json_add_array wans
	wan_records > "$NIJIKA_RUNDIR/wanrec.$$"
	while IFS='|' read -r rec ifi cm st vl vid app at dgw ipp; do
		[ -n "$ifi" ] || continue
		ppp=$(( (ifi >> 8) & 255 )) vc=$(( ifi & 255 ))
		if [ "$ppp" != 255 ]; then ifn=ppp$ppp; else ifn=nas0_$vc; fi
		ip4= gw4= ip6=
		if [ -d "/sys/class/net/$ifn" ]; then
			line=$(ip -4 -o addr show dev "$ifn" 2>/dev/null | head -n 1)
			ip4=$(echo "$line" | awk '{ for (i = 1; i < NF; i++) if ($i == "inet") { print $(i + 1); exit } }')
			gw4=$(echo "$line" | awk '{ for (i = 1; i < NF; i++) if ($i == "peer") { print $(i + 1); exit } }')
			gw4=${gw4%/*}
			[ -n "$gw4" ] || gw4=$(cat "$RTK/tmp/MERgw.$ifn" /tmp/MERgw."$ifn" 2>/dev/null | head -n 1)
			[ -n "$gw4" ] || gw4=$(ip -4 route show table all dev "$ifn" 2>/dev/null | awk '$1 == "default" && $2 == "via" { print $3; exit }')
			ip6=$(ip -6 -o addr show dev "$ifn" scope global 2>/dev/null | awk '{ print $4; exit }')
			if [ "$cm" = 0 ]; then
				[ "$(cat "/sys/class/net/$ifn/operstate" 2>/dev/null)" = down ] && state=down || state=up
			elif [ -n "$ip4$ip6" ]; then
				state=up
			else
				state=connecting
			fi
		else
			state=down
		fi
		[ "$st" = 0 ] && state=disabled
		json_add_object
		json_add_int index "$rec"
		json_add_string name "PON_$vc"
		json_add_string ifname "$ifn"
		json_add_string ifIndex "$ifi"
		json_add_string ChannelMode "$cm"
		json_add_string ChannelAddrType "$at"
		json_add_string applicationtype "$app"
		json_add_string vid "$( [ "$vl" = 1 ] && echo "$vid")"
		json_add_boolean default_route "$( [ "$dgw" = 1 ] && echo 1 || echo 0)"
		json_add_string ip4 "${ip4%/*}"
		json_add_string prefix4 "$( [ "${ip4#*/}" != "$ip4" ] && echo "${ip4#*/}")"
		json_add_string gw4 "$gw4"
		json_add_string ip6 "$ip6"
		json_add_string state "$state"
		json_close_object
	done < "$NIJIKA_RUNDIR/wanrec.$$"
	rm -f "$NIJIKA_RUNDIR/wanrec.$$"
	json_close_array
	json_dump
}

# --- dynamic DNS (Services > DDNS) -----------------------------------------

DDNS=/usr/libexec/nijika/ddns

# the address check, each entry's last result, the stock entries
m_ddns_status() {
	"$DDNS" status 2>/dev/null || err "no DDNS status"
}

# update every entry now: the service does it when it runs, else one pass
# in the background (the page polls ddns_status)
m_ddns_update() {
	local running=0
	"$DDNS" status 2>/dev/null | grep -q '"running": true' && running=1
	if [ $running = 1 ]; then
		"$DDNS" update -f >/dev/null 2>&1
	else
		( "$DDNS" update -f >/dev/null 2>&1 & )
	fi
	json_init
	json_add_boolean ok 1
	json_add_boolean running "$running"
	json_dump
}

# --- WireGuard (Services > WireGuard) --------------------------------------

WG=/usr/libexec/nijika/wireguard

m_wg_status() {
	"$WG" status 2>/dev/null || err "no WireGuard status"
}

is_wgkey() { # base64 of 32 bytes
	echo "$1" | grep -qE '^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw480]=$'
}

# {"private_key": k} -> its public key; {} -> a new key pair and a
# preshared key
m_wg_keys() {
	local key
	json_load "$1"
	json_get_var key private_key
	json_init
	if [ -n "$key" ]; then
		is_wgkey "$key" || err "not a WireGuard key"
		json_add_string public_key "$(echo "$key" | wg pubkey)"
	else
		key=$(wg genkey)
		json_add_string private_key "$key"
		json_add_string public_key "$(echo "$key" | wg pubkey)"
		json_add_string preshared_key "$(wg genpsk)"
	fi
	json_dump
}

# {"section": s} -> the peer's client configuration and its QR code (SVG)
m_wg_client() {
	local sec conf
	json_load "$1"
	json_get_var sec section
	case "$sec" in ''|*[!A-Za-z0-9_]*) err "invalid section" ;; esac
	mkdir -p "$NIJIKA_RUNDIR"
	conf=$("$WG" client "$sec" 2>"$NIJIKA_RUNDIR/wgc.$$") || {
		local e
		e=$(cat "$NIJIKA_RUNDIR/wgc.$$"); rm -f "$NIJIKA_RUNDIR/wgc.$$"
		err "$e"
	}
	rm -f "$NIJIKA_RUNDIR/wgc.$$"
	json_init
	json_add_string config "$conf"
	command -v qrencode >/dev/null &&
		json_add_string qr "$(printf '%s\n' "$conf" | qrencode -t SVG -l L -m 2 -o - 2>/dev/null)"
	json_dump
}


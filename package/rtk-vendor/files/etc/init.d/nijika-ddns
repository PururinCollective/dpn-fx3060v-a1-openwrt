#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Dynamic DNS (LuCI: Services > DDNS): /usr/libexec/nijika/ddns keeps the
# nijika.ddns_host entries on the router's public IPv4 address. Runs when
# nijika.ddns.enabled is on and an entry is enabled; a settings change
# restarts it (changed entries are updated at once).

START=96
USE_PROCD=1
PROG=/usr/libexec/nijika/ddns

ddns_host_on() {
	local en
	config_get_bool en "$1" enabled 1
	[ "$en" = 1 ] && DDNS_HOSTS=1
}

start_service() {
	local en
	config_load nijika
	config_get_bool en ddns enabled 1
	DDNS_HOSTS=0
	config_foreach ddns_host_on ddns_host
	[ "$en" = 1 ] && [ "$DDNS_HOSTS" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param file /etc/config/nijika
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nijika
}

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Neighbor announcements (LuCI: NijikaWrt > Settings, CLI: nijika announce):
# /usr/libexec/nijika/announce sends LLDP and MikroTik MNDP out of each LAN
# port. Runs when nijika.announce.lldp or nijika.announce.mndp is on; a
# settings change restarts it. The LAN bridge of the stock stack may come
# up later: the ports and addresses are read again every 5 s.

START=94
USE_PROCD=1
PROG=/usr/libexec/nijika/announce

start_service() {
	local lldp mndp
	config_load nijika
	config_get_bool lldp announce lldp 1
	config_get_bool mndp announce mndp 1
	[ "$lldp" = 1 ] || [ "$mndp" = 1 ] || return 0
	[ -x /usr/libexec/nijika/nbannounce ] || return 0

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param file /etc/config/nijika
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nijika
}

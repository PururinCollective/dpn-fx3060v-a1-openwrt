#!/bin/sh
# nijika-housekeep: re-apply what the stock stack may undo.
#  - every 10 s: the OpenWrt hostname (stock `startup` writes DEVICE_NAME
#    over it, also right after the vendor boot is marked done)
#  - every 60 s: LAN access to SSH/LuCI in the stock iptables (rebuilt on WAN
#    changes) and the /var mirror for paths the stock drivers open from
#    kernel threads
# PON/ONT status is NOT polled here: it is read on demand (see pon.sh).

RTK=/rtk

while [ ! -f "$RTK/var/run/.start_up_run_file" ]; do
	sleep 2
done

n=0
while :; do
	/usr/libexec/rtk/hostname
	if [ $((n % 6)) = 0 ]; then
		/usr/libexec/rtk/lan-mgmt
		/usr/libexec/rtk/var-mirror
	fi
	n=$((n + 1))
	sleep 10
done

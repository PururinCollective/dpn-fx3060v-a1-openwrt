#!/bin/sh
# Run the (patched) stock rc chain inside /rtk.
#
#   vendor-boot early   rc0..rc9: mounts, configd, DSP, kernel drivers, OMCI.
#                       Runs synchronously from /etc/init.d/rtk-vendor so no
#                       OpenWrt service (netifd, rpcd, ...) runs while the
#                       Realtek drivers initialise, exactly like on stock.
#   vendor-boot late    rc10..rc63 (sysctl, systemd, startup, voip, ...) in
#                       the background, then the NijikaWrt post-boot hooks.

. /lib/functions.sh

RTK=/rtk
MARK="$RTK/var/run/.start_up_run_file"
EARLY_DONE="$RTK/var/nijika/early.done"
LOG=/tmp/log/rtk-boot.log
EARLY_TIMEOUT=150

config_load nijika
config_get_bool console vendor console 1

mkdir -p "$RTK/var/nijika" /tmp/log

# Output of the stock scripts: serial console (like stock), or a file for
# the synchronous phase / the system log for the background phase. A pipe
# cannot be used for the synchronous phase: daemons started by the rc
# scripts keep it open and the phase would never "finish".
rc_out() {
	if [ "$console" = 1 ]; then echo /dev/console; else echo "$LOG"; fi
}

early() {
	[ -f "$EARLY_DONE" ] && return 0

	# Interfaces created by the Realtek drivers must not start IPv6 (MLD)
	# before the driver has finished probing: ca_ne crashes transmitting
	# through its not yet registered TX hook. Stock rc14 sets the same value
	# later; the stock stack enables IPv6 per interface when configured.
	echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6

	# DNS over HTTPS switch for the stock dnsmasq wrapper, before the stock
	# stack first starts dnsmasq (late phase)
	/usr/libexec/rtk/doh-apply boot

	logger -t rtk-vendor "early phase: stock rc0..rc9"
	/usr/libexec/rtk/run /bin/sh /etc/nijika/rcS 0 9 </dev/null >>"$(rc_out)" 2>&1 &
	local pid=$! i=0
	while kill -0 "$pid" 2>/dev/null; do
		if [ $i -ge $EARLY_TIMEOUT ]; then
			logger -t rtk-vendor "early phase still running after ${i}s, continuing boot"
			break
		fi
		sleep 1
		i=$((i + 1))
	done
	logger -t rtk-vendor "early phase done after ${i}s"
	touch "$EARLY_DONE"
	/usr/libexec/rtk/var-mirror

	# Stock SPI firewall switches (nijika.firewall): configd is up now, the
	# stock `startup` (late phase) builds the iptables chains from them.
	/usr/libexec/rtk/spi-firewall boot
}

late() {
	if [ -f "$MARK" ]; then
		logger -t rtk-vendor "vendor stack already up"
		return 0
	fi

	logger -t rtk-vendor "late phase: stock rc10..rc63"
	if [ "$console" = 1 ]; then
		/usr/libexec/rtk/run /bin/sh /etc/nijika/rcS 10 63 mark </dev/null >/dev/console 2>&1 &
	else
		( /usr/libexec/rtk/run /bin/sh /etc/nijika/rcS 10 63 mark </dev/null 2>&1 | logger -t rtk ) &
	fi

	local i=0
	while [ ! -f "$MARK" ] && [ $i -lt 300 ]; do
		sleep 1
		i=$((i + 1))
		/usr/libexec/rtk/var-mirror
	done

	if [ -f "$MARK" ]; then
		logger -t rtk-vendor "stock userland up after ${i}s"
		echo "up ${i}s" >> "$LOG"
	else
		logger -t rtk-vendor "stock rc chain did not finish within ${i}s"
		echo "timeout ${i}s" >> "$LOG"
	fi

	for hook in /usr/libexec/rtk/post-boot.d/*; do
		[ -x "$hook" ] || continue
		logger -t rtk-vendor "post-boot: ${hook##*/}"
		"$hook" 2>&1 | logger -t rtk-vendor
	done
}

case "$1" in
	early) early ;;
	late) late ;;
	*) echo "usage: $0 early|late" >&2; exit 1 ;;
esac
exit 0

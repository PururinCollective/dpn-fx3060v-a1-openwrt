#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# Run a command inside the stock Realtek chroot with the stock environment.
#   /usr/libexec/rtk/run /bin/flash get GPON_SN
# Without arguments an interactive stock shell is started.

RTK=/rtk

grep -q " $RTK/proc " /proc/mounts || {
	echo "rtk: vendor chroot is not mounted (rtk-vendor not started?)" >&2
	exit 127
}

[ $# -gt 0 ] || set -- /bin/sh -l

# procd_lock (rc.common start/reload) holds a flock on fd 1000. A stock
# daemon started from an init script (vendor boot, rtk-apply restarting
# pppd or dhcpd from a reload) would inherit it and keep the lock for
# ever: every later reload of that service then waits in flock for ever.
exec 1000>&-

# Same environment the stock busybox init gives its rc scripts and daemons
# (its compiled-in PATH includes /etc/scripts: fw_loaded.sh, cmd, cmd1, ...).
exec env -i \
	PATH=/sbin:/usr/sbin:/bin:/usr/bin:/etc/scripts \
	HOME=/ \
	SHELL=/bin/sh \
	USER=root \
	TERM="${TERM:-vt102}" \
	chroot "$RTK" "$@"

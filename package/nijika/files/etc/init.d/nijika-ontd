#!/bin/sh /etc/rc.common
# PON status cache for banner / LuCI / CLI.

START=95
USE_PROCD=1

start_service() {
	local enabled
	config_load nijika
	config_get_bool enabled ontd enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/nijika/ontd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nijika
}

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

# NijikaWrt board identity (from the device profile the image was built
# for, /etc/nijika_release). No network/switch/LED defaults on purpose: the
# stock Realtek stack owns the hardware (see /etc/config/network).

. /lib/functions/uci-defaults.sh

[ -f /etc/nijika_release ] && . /etc/nijika_release

board_config_update

ucidef_set_board_id "${NIJIKA_BOARD:-dlink,dpn-fx3060v-a1}"
ucidef_set_model_name "${NIJIKA_MODEL:-D-Link DPN-FX3060V (A1)}"

board_config_flush

exit 0

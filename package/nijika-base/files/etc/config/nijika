
config vendor 'vendor'
	# The stock web server (boa) always runs: the stock stack needs it (it
	# starts the VoIP flash server, among others). Its D-Link GUI listens
	# on port 8080:  'hidden' = only from the router itself (SSH tunnel),
	#                'lan'    = also from the LAN.
	option boa 'hidden'
	# Print the stock vendor boot output on the serial console (1) or
	# send it to the system log (0, see: logread -e rtk).
	option console '1'
	# Stock inetd (telnet on 23). OpenWrt's dropbear serves SSH on 22.
	option inetd '0'
	# Keep SSH/LuCI reachable from the LAN through the stock firewall.
	option lan_mgmt '1'
	option lan_ifname 'br0'

config firewall 'firewall'
	# The stock "SPI Firewall" switches (stock GUI: Firewall > IPv4/IPv6
	# Port Filtering), pinned in the stock configuration at every boot:
	#   off   new connections allowed both ways
	#   on    stock default: new incoming connections dropped
	#   keep  leave what the stock GUI set
	# off for IPv6 means LAN devices with a public IPv6 address are
	# reachable from the internet: their own firewall protects them. The
	# stock configuration is shared with the stock firmware bank.
	option spi_ipv4 'off'
	option spi_ipv6 'off'

config banner 'banner'
	# ssh | always | never
	option animate 'ssh'
	# auto | truecolor | 256 | 16 | none
	option color 'auto'

config pon 'pon'
	# PON/ONT status (diag, omcicli) is read on demand when LuCI, `nijika
	# info` or the login banner asks, and reused for this many seconds.
	option cache_ttl '5'

config uci 'uci'
	# Chain tables mirrored into /etc/config/rtk as rtk.<TABLE>_<n>.<field>,
	# next to every scalar in rtk.mib.<KEY> (see /usr/libexec/rtk/uci-mirror).
	option tables 'ATM_VC_TBL WLAN_MBSSIB_TBL WLAN1_MBSSIB_TBL'

config doh 'doh'
	# DNS over HTTPS for the LAN and the router: the stock dnsmasq sends
	# every lookup to https-dns-proxy on 127.0.0.1:<listen_port>, except the
	# ISP's own domains (voice/IMS, TR-069), which stay on the ISP's DNS.
	option enabled '1'
	option resolver_url 'https://b.hitoha.moe/dns-query'
	# Plain DNS used only to look up the resolver's host name.
	option bootstrap_dns '1.1.1.1,8.8.8.8'
	option listen_port '5053'


config vendor 'vendor'
	# The stock web server (boa) always runs: the stock stack needs it (it
	# starts the VoIP flash server, among others). Its D-Link GUI listens
	# on port 8080:  'hidden' = only from the router itself (SSH tunnel),
	#                'lan'    = also from the LAN.
	option boa 'hidden'
	# Apply stock configuration changes (Quick Setup, MIB editor,
	# /etc/config/rtk, SPI firewall) to the running stack like the stock
	# web forms do (/rtk/bin/rtk-apply); 0: every change waits for a reboot.
	option live_apply '1'
	# Print the stock vendor boot output on the serial console (1) or
	# send it to the system log (0, see: logread -e rtk).
	option console '1'
	# Syslog of the stock services in `logread` up to this level:
	# 3 err, 4 warning, 5 notice (stock default), 6 info, 7 debug
	# (6/7: VoIP_maserati alone logs about a line a second).
	option stock_log '5'
	# Stock inetd (telnet on 23). OpenWrt's dropbear serves SSH on 22.
	option inetd '0'
	# Stock TR-069 client (cwmpClient) and SNMP agent (snmpd): off, so the
	# ISP's ACS cannot reconfigure the stock stack behind OpenWrt's back.
	# The TR-069 WAN connection stays up either way, and the stock
	# configuration (shared with the stock firmware bank) keeps its settings.
	option tr069 '0'
	option snmp '0'
	# EasyMesh role pinned in the stock configuration at every boot:
	#   controller  this router runs the mesh, satellites pair with it
	#   disabled    no EasyMesh
	#   auto        D-Link/TM default, left alone: with no fibre the WPS
	#               button turns this unit into a mesh node (satellite:
	#               LAN DHCP client, no DHCP server) - for a spare unit only
	option easymesh 'controller'
	# wifi_defaults: the last step of the NijikaWrt WiFi defaults written to
	# the stock configuration at first boot (1: OFDMA, 802.11r, 2.4 GHz
	# without 802.11b; 2: band steering when the SSIDs match); delete it to
	# write them again.
	# Keep SSH/LuCI reachable from the LAN through the stock firewall.
	option lan_mgmt '1'
	option lan_ifname 'br0'

config wifi 'wifi'
	# 802.11ax BSS colouring per radio (wlan0 5 GHz, wlan1 2.4 GHz): the
	# stock firmware leaves it off; NijikaWrt gives each radio a colour from
	# its MAC address (see /rtk/bin/hostapd).
	option bss_color_wlan0 '1'
	option bss_color_wlan1 '1'

config firewall 'firewall'
	# The stock "SPI Firewall" switches (stock GUI: Firewall > IPv4/IPv6
	# Port Filtering), pinned in the stock configuration at every boot:
	#   off   new connections allowed both ways
	#   on    stock default: new incoming connections dropped
	#   keep  leave what the stock GUI set
	# off for IPv6 means LAN devices with a public IPv6 address are
	# reachable from the internet: their own firewall protects them. The
	# stock configuration is shared with the stock firmware bank.
	option spi_ipv4 'off'
	option spi_ipv6 'off'

config banner 'banner'
	# always | ssh | never (at 115200 baud the serial console takes a moment)
	option animate 'always'
	# auto | truecolor | 256 | 16 | none
	option color 'auto'

config pon 'pon'
	# PON/ONT status (diag, omcicli) is read on demand when LuCI, `nijika
	# info` or the login banner asks, and reused for this many seconds.
	option cache_ttl '5'

config uci 'uci'
	# Chain tables mirrored into /etc/config/rtk as rtk.<TABLE>_<n>.<field>,
	# next to every scalar in rtk.mib.<KEY> (see /usr/libexec/rtk/uci-mirror).
	option tables 'ATM_VC_TBL WLAN_MBSSIB_TBL WLAN1_MBSSIB_TBL'

config doh 'doh'
	# DNS over HTTPS for the LAN and the router: the stock dnsmasq sends
	# every lookup to https-dns-proxy on 127.0.0.1:<listen_port>, except the
	# ISP's own domains (voice/IMS, TR-069), which stay on the ISP's DNS.
	option enabled '1'
	option resolver_url 'https://b.hitoha.moe/dns-query'
	# Plain DNS used only to look up the resolver's host name.
	option bootstrap_dns '1.1.1.1,8.8.8.8'
	option listen_port '5053'

config ddns 'ddns'
	# Dynamic DNS (LuCI: Services > DDNS, /usr/libexec/nijika/ddns): the A
	# records (IPv4 only) of the ddns_host entries follow the router's
	# public address. Replaces the stock DDNS client (MIB_DDNS_TBL).
	option enabled '1'
	# The WAN whose address is published: auto = the one with the default
	# route (ppp0 with PPPoE), or an interface name.
	option interface 'auto'
	# When that address is not public (carrier-grade NAT 100.64.0.0/10, a
	# private or reserved range), the address the internet sees comes from
	# the first of these that answers (plain text), and the status warns:
	# it is shared, connections from the internet do not reach the router.
	list ip_url 'http://ip1.dynupdate.no-ip.com/'
	list ip_url 'https://api.ipify.org/'
	list ip_url 'https://ipv4.icanhazip.com/'
	# Seconds between those lookups; an unchanged address is sent again
	# after force_interval (stock DDNS_SYNC_INTERVAL: 86400).
	option check_interval '600'
	option force_interval '86400'

# One per provider account, e.g.:
# config ddns_host
#	option enabled '1'
#	# dyndns noip changeip gnudip dynu freedns (afraid.org user name and
#	# password), afraid (freedns.afraid.org update URL or token: url),
#	# cloudflare (zone, email + api_key = global API key, or api_key alone
#	# = API token)
#	option provider 'cloudflare'
#	option hostname 'example.org,www.example.org'
#	option zone 'example.org'
#	option email 'me@example.org'
#	option api_key '...'

config ui 'ui'
	# Developer options: show expert pages in LuCI (PON > ONT Identity)
	option developer '0'

#!/bin/sh
# NijikaWrt first boot defaults.

# uhttpd: HTTP only (no TLS stack shipped), LuCI on port 80 of every
# interface; the stock firewall decides who may reach it.
uci -q batch <<'EOF'
delete uhttpd.main.listen_https
set uhttpd.main.redirect_https='0'
set uhttpd.main.rfc1918_filter='0'
commit uhttpd
EOF

# r1..r6 knew a boa shim: shim -> hidden, stock -> lan (kept settings).
case "$(uci -q get nijika.vendor.boa)" in
	shim) uci -q set nijika.vendor.boa='hidden'; uci -q commit nijika ;;
	stock) uci -q set nijika.vendor.boa='lan'; uci -q commit nijika ;;
esac

# Sections added after r1 (kept settings from an older NijikaWrt).
uci -q get nijika.wifi >/dev/null || uci -q batch <<'END'
set nijika.wifi=wifi
set nijika.wifi.bss_color_wlan0='1'
set nijika.wifi.bss_color_wlan1='1'
commit nijika
END
uci -q get nijika.vendor.easymesh >/dev/null || uci -q batch <<'END'
set nijika.vendor.easymesh='controller'
commit nijika
END
uci -q get nijika.vendor.tr069 >/dev/null || uci -q batch <<'END'
set nijika.vendor.tr069='0'
set nijika.vendor.snmp='0'
commit nijika
END
uci -q get nijika.doh >/dev/null || uci -q batch <<'END'
set nijika.doh=doh
set nijika.doh.enabled='1'
set nijika.doh.resolver_url='https://b.hitoha.moe/dns-query'
set nijika.doh.bootstrap_dns='1.1.1.1,8.8.8.8'
set nijika.doh.listen_port='5053'
commit nijika
END
uci -q get nijika.uci >/dev/null || uci -q batch <<'END'
set nijika.uci=uci
set nijika.uci.tables='ATM_VC_TBL WLAN_MBSSIB_TBL WLAN1_MBSSIB_TBL'
commit nijika
END
uci -q get nijika.firewall >/dev/null || uci -q batch <<'END'
set nijika.firewall=firewall
set nijika.firewall.spi_ipv4='off'
set nijika.firewall.spi_ipv6='off'
commit nijika
END

uci -q get nijika.ddns >/dev/null || uci -q batch <<'END'
set nijika.ddns=ddns
set nijika.ddns.enabled='1'
set nijika.ddns.interface='auto'
add_list nijika.ddns.ip_url='http://ip1.dynupdate.no-ip.com/'
add_list nijika.ddns.ip_url='https://api.ipify.org/'
add_list nijika.ddns.ip_url='https://ipv4.icanhazip.com/'
set nijika.ddns.check_interval='600'
set nijika.ddns.force_interval='86400'
commit nijika
END

uci -q get nijika.ui >/dev/null || uci -q batch <<'END'
set nijika.ui=ui
set nijika.ui.developer='0'
commit nijika
END

# Time comes from the stock stack.
/etc/init.d/sysntpd disable 2>/dev/null

# Interfaces are not managed by OpenWrt, packet steering would fight the
# stock RPS settings (rps.sh).
/etc/init.d/packet_steering disable 2>/dev/null

exit 0

# NijikaWrt: make sure the UBI volume "rootfs_data" exists before
# mount_root looks for it, and process a pending wipe left by sysupgrade.
#
# The stock UBI layout leaves free PEBs; rootfs_data takes them (minus a small
# reserve) with a high volume id so the gluebi mtd numbers of the stock volumes
# (root=31:8 / 31:11) never shift.
#
# UBI can be briefly busy (EBUSY) right after attach or ubimkvol on this SoC:
# the first UBIFS mount then races UBI's own background work. On the B1 that
# left the first boot after a factory flash with no overlay (read-only root:
# dropbear could not write host keys, /etc/config/rtk could not be created)
# until a second boot found the volume ready. The create and the mounts are
# retried on EBUSY, and each step is logged to /dev/kmsg so a first-boot
# failure is visible in the kernel log without a serial console.

NIJIKA_DATA_VOL=rootfs_data
NIJIKA_DATA_ID=120
NIJIKA_DATA_RESERVE=8
NIJIKA_DATA_TRIES=10
NIJIKA_GLIBC=/usr/libexec/rtk/glibc

nijika_log() {
	echo "- nijika: $* -"
	echo "nijika rootfs_data: $*" > /dev/kmsg 2>/dev/null
}

# nijika_retry <tries> <cmd...>: run until it succeeds or the tries run out,
# pausing 1s between attempts (for transient UBI EBUSY right after attach).
nijika_retry() {
	local n="$1"
	shift
	while :; do
		"$@" && return 0
		n=$((n - 1))
		[ "$n" -gt 0 ] || return 1
		sleep 1
	done
}

nijika_ubi_has_vol() {
	local d
	for d in /sys/class/ubi/ubi0_*; do
		[ "$(cat "$d/name" 2>/dev/null)" = "$1" ] && return 0
	done
	return 1
}

nijika_mkvol() {
	$NIJIKA_GLIBC /rtk/bin/ubimkvol /dev/ubi0 -n $NIJIKA_DATA_ID -N $NIJIKA_DATA_VOL -s "$1"
}

nijika_rootfs_data() {
	local mnt=/tmp/.nijika_data avail leb size

	[ -c /dev/ubi0 ] || return 0

	if ! nijika_ubi_has_vol "$NIJIKA_DATA_VOL"; then
		avail=$(cat /sys/class/ubi/ubi0/avail_eraseblocks 2>/dev/null)
		leb=$(cat /sys/class/ubi/ubi0/eraseblock_size 2>/dev/null)
		[ -n "$avail" ] && [ -n "$leb" ] || return 0
		if [ "$avail" -le $((NIJIKA_DATA_RESERVE + 16)) ]; then
			nijika_log "only $avail free PEBs, no persistent overlay"
			return 0
		fi
		size=$(( (avail - NIJIKA_DATA_RESERVE) * leb ))
		nijika_log "creating UBI volume $NIJIKA_DATA_VOL ($((size / 1048576)) MiB)"
		if ! nijika_retry $NIJIKA_DATA_TRIES nijika_mkvol "$size"; then
			nijika_log "ubimkvol failed, no persistent overlay"
			return 0
		fi
		# Let UBIFS lay down an empty filesystem so fstools recognises it and
		# mount_root (the next preinit hook) finds a ready volume. This first
		# mount is the one that raced UBI settling right after ubimkvol, so
		# retry it rather than giving up and leaving a read-only root.
		mkdir -p $mnt
		if nijika_retry $NIJIKA_DATA_TRIES mount -t ubifs ubi0:$NIJIKA_DATA_VOL $mnt; then
			umount $mnt
		else
			nijika_log "could not format $NIJIKA_DATA_VOL (UBI busy); overlay may be unavailable this boot"
		fi
	fi

	mkdir -p $mnt
	nijika_retry $NIJIKA_DATA_TRIES mount -t ubifs ubi0:$NIJIKA_DATA_VOL $mnt || return 0
	if [ -f $mnt/.nijika_wipe ]; then
		nijika_log "firmware changed, resetting overlay"
		[ -f $mnt/.nijika_keep.tgz ] && gzip -dc $mnt/.nijika_keep.tgz > /tmp/sysupgrade.tar
		rm -rf $mnt/* $mnt/.[!.]* 2>/dev/null
		sync
	fi
	umount $mnt
}

boot_hook_add preinit_main nijika_rootfs_data

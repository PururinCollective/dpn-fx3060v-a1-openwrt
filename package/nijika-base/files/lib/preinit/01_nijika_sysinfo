# NijikaWrt: the stock device tree says "Realtek Taurus ENG Board"; give
# OpenWrt (LuCI, sysupgrade) the real board identity. Runs before
# 02_sysinfo, which only fills in missing values.

nijika_sysinfo() {
	local NIJIKA_BOARD NIJIKA_MODEL
	[ -f /etc/nijika_release ] && . /etc/nijika_release
	mkdir -p /tmp/sysinfo
	echo "${NIJIKA_BOARD:-dlink,dpn-fx3060v-a1}" > /tmp/sysinfo/board_name
	echo "${NIJIKA_MODEL:-D-Link DPN-FX3060V (A1)}" > /tmp/sysinfo/model
}

boot_hook_add preinit_main nijika_sysinfo
